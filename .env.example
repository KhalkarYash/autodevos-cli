# ===============================================
# Ollama Configuration (Local Llama Model)
# ===============================================
# For local Ollama: Leave API_KEY empty (uses "ollama" as default)
# For remote Ollama: Set BASE_URL to http://<remote-ip>:11434/v1
#
# Example for remote laptop:
#   BASE_URL=http://192.168.1.100:11434/v1
# ===============================================

# API key (optional for Ollama, required for OpenRouter/OpenAI)
API_KEY=

# Base URL for the model server
# Local Ollama: http://localhost:11434/v1
# Remote Ollama: http://<ip-address>:11434/v1
# OpenRouter: https://openrouter.ai/api/v1
BASE_URL=http://localhost:11434/v1

# Hook environment variables (for automation)
AI_AGENT_TRIGGER=
AI_AGENT_CWD=
AI_AGENT_TOOL_NAME=
AI_AGENT_USER_MESSAGE=
AI_AGENT_ERROR=