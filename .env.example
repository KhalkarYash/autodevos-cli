# ===============================================
# AutoDevOS CLI - LLM Provider Configuration
# ===============================================
#
# Supported Providers:
#   - ollama      : Local Ollama server (default, no API key needed)
#   - openai      : OpenAI API (gpt-4o, gpt-4, etc.)
#   - anthropic   : Anthropic Claude (claude-sonnet-4-20250514, claude-3-opus, etc.)
#   - gemini      : Google Gemini (gemini-1.5-pro, gemini-1.5-flash)
#   - openrouter  : OpenRouter.ai (any model)
#   - lmstudio    : LM Studio local server
#   - vllm        : vLLM inference server
#   - custom      : Any OpenAI-compatible endpoint
#
# ===============================================

# API Key (required for: openai, anthropic, gemini, openrouter)
# Not required for: ollama, lmstudio, vllm
API_KEY=

# Base URL for the model server
# Leave empty to use provider defaults, or override:
#
# Ollama (local):    http://localhost:11434/v1
# Ollama (remote):   http://192.168.1.100:11434/v1
# OpenAI:            https://api.openai.com/v1
# Anthropic:         https://api.anthropic.com
# Gemini:            https://generativelanguage.googleapis.com/v1beta
# OpenRouter:        https://openrouter.ai/api/v1
# LM Studio:         http://localhost:1234/v1
# vLLM:              http://localhost:8000/v1
BASE_URL=

# ===============================================
# Hook Environment Variables (for automation)
# ===============================================
AI_AGENT_TRIGGER=
AI_AGENT_CWD=
AI_AGENT_TOOL_NAME=
AI_AGENT_USER_MESSAGE=
AI_AGENT_ERROR=